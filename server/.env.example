# Copy this file to .env and fill in what you need. Never commit .env.

# Leave empty for local dev: the API then uses PGlite (no install) and saves data in ./.pglite
# In production (Vercel), set this to your Postgres connection string (e.g. Supabase pooler URL).
DATABASE_URL=

# Only if your Postgres provider uses its own certificate authority (paste the PEM certificate).
DATABASE_CA_CERT=

# production turns on secure (HTTPS-only) cookies and trusts the Vercel proxy.
NODE_ENV=development

PORT=3001

# Password hashing cost. 12 is a good default; tests use 4 to run fast.
BCRYPT_ROUNDS=12

SESSION_DAYS=7

# Max login/register attempts per IP per 15 minutes (0 = off).
AUTH_RATE_LIMIT=20
