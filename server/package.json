{
  "name": "portfolio-app-server",
  "version": "0.1.0",
  "description": "Back end for the portfolio app: broker import, rebalancing, dividend projection and tax-loss scanning.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch scripts/dev.js",
    "start": "node scripts/dev.js",
    "build": "npm --prefix ../client ci --include=dev && npm --prefix ../client run build && rm -rf public && cp -r ../client/dist public",
    "db:migrate": "node src/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:rebalance": "node scripts/demo-rebalance.js",
    "demo:dividends": "node scripts/demo-dividends.js",
    "demo:tax-loss": "node scripts/demo-tax-loss.js",
    "demo:import": "node scripts/demo-import.js"
  },
  "author": "Siang Ling",
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
